# 复制为 .env 后填写。.env 已在 .gitignore 中，绝不能提交。
# 这里只列变量名和说明，不放任何真实值。

# 网页挂载路径（社团服务器 nginx 转发到这里），默认 /booksmith；挂在根路径填 /
BASE_PATH=
# 监听端口，默认 8100
PORT=
# SQLite、产物（PDF/PPTX/diff）、上传附件、worktree 的目录。留空使用启动目录，未设置此变量时使用 /data
DATA_DIR=
# 书稿仓库主克隆，默认 /book（基线分支 master）
BOOK_REPO_DIR=
# 审核通过后推送的远程（远程名如 origin，或 URL）；留空则只在本地合并
BOOK_GIT_REMOTE=
# 会话签名密钥（长随机串）；留空时自动生成并保存在 DATA_DIR/secret_key
SECRET_KEY=
# 真实流水线的模型，格式为 服务商/模型ID。留空默认 deepseek/deepseek-flash
BOOKSMITH_MODEL=
# 所选模型的 API key。使用默认 DeepSeek 时，模型配置只需填这一项
BOOKSMITH_MODEL_API_KEY=
# 内置服务商可留空。OpenAI 兼容接口填服务商的基础地址，同时将模型设为 custom/模型ID
BOOKSMITH_MODEL_BASE_URL=
# Tavily API key（维护、出新两种任务联网检索用；留空则不能检索）
TAVILY_API_KEY=
# 每个任务最多调用几次联网检索（search + extract），默认 25
BOOKSMITH_WEBSEARCH_LIMIT=
# 流水线：fake（开发/测试，默认）| real（app/pipelines/real.py 提供的真实流水线）
BOOKSMITH_PIPELINES=
# FakePipeline 每步停顿秒数，默认 0.5
BOOKSMITH_FAKE_DELAY=
# 设为 0 时不启动内置任务队列线程（一般不用改）
BOOKSMITH_WORKER=
